.env
node_modules
supabase/.temp/
.DS_Store
src/.DS_Store
screenshots/
session-ref.json
# The same session, copied where the dev server can serve it to a browser
# harness. Round 39 committed this once: it carries an access token and a
# refresh token, and it is deleted after every use. Ignored so a stray
# `git add -A` cannot repeat that.
frontend/.dev-session.json

# Editor/agent local settings (machine-specific; also in the global ignore).
.claude/settings.local.json

# One-shot verification harnesses, repo root only.
# Precedent: reusable tooling lives in scripts/ and is tracked; these are
# round-scoped, hardcode absolute paths, and require session-ref.json.
/verify-*.mjs
/debug-*.mjs
/get-session-*.mjs
/.scratch/
.verify/
