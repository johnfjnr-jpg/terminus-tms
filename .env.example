# Copy to .env and fill in values from your Supabase project settings.
# Never commit .env to source control.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable/anon key — safe to expose in the browser; powerless without a
# valid user JWT for anything RLS protects.
SUPABASE_PUBLISHABLE_KEY=eyJ...

# Service role key — bypasses RLS entirely. Never send to the browser.
# See src/supabase.js SERVICE ROLE USAGE LOG before using this anywhere.
SUPABASE_SECRET_KEY=eyJ...

# JWKS endpoint for local JWT signature verification (no round-trip per request)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Supabase Auth / Google OAuth setup notes ──────────────────────────────────
# 1. Google Cloud Console → OAuth 2.0 Client:
#      Authorized redirect URI: https://your-project-ref.supabase.co/auth/v1/callback
#
# 2. Supabase Dashboard → Authentication → URL Configuration:
#      Site URL: http://localhost:3000        (dev)  or your Render URL (prod)
#      Redirect URLs: add both http://localhost:3000 and your Render URL
#
# 3. Supabase Dashboard → Authentication → Providers → Google:
#      Paste in the Google Client ID and Secret from step 1.
