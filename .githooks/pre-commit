#!/bin/sh
# Refuse a commit when a scripted edit batch did not fully land.
#
# Round 39 close. Twice in one round a scripted edit reported success while the
# file was unchanged, and the commit went ahead describing a correction the file
# did not contain. The message was truthful about the intent and false about the
# result, which is the signature of the class this hook closes.
#
# scripts/lib/edit.mjs writes .edit-journal.json before each edit and updates it
# after. A crashed script leaves a `pending` entry; a failed anchor leaves
# `failed`. Either blocks the commit. endBatch() removes the file when every
# edit landed, so a clean batch leaves nothing here to check.
#
# Reported through node rather than sed: the journal is JSON and a line-based
# reader mangles it, which would make the refusal message itself untrustworthy.
# ── GUARD 2 (added 2026-09-11): a suite is red ───────────────────────────
#
# Ruled by John as the mechanical answer to a fault that recurred while the
# rule against it was known and quoted. See scripts/pre-commit-suites.mjs for
# what it runs and what it deliberately does not.
#
# Runs BEFORE the journal check below only in the sense that it is written
# first; the journal check is cheap and exits immediately when there is no
# journal, so order costs nothing either way.
node scripts/pre-commit-suites.mjs || exit 1

# ── GUARD 1: a scripted edit batch did not fully land ────────────────────
# Both journal guards live in a real script rather than shell-quoted JS: the
# routing guard needs git's staged list and must fail closed, and neither is
# writable inside a single-quoted -e string without the quoting becoming the
# thing most likely to break.
exec node scripts/hooks/journal-guard.mjs
